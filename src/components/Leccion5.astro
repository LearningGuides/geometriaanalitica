---
export type SlopeGraphType =
  | "slope-types"
  | "constant-slope"
  | "positive-one"
  | "steep-positive"
  | "negative"
  | "horizontal"
  | "vertical"
  | "slope-comparison"
  | "angle";

interface Props {
  type: SlopeGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId = `slope-${type}-${crypto.randomUUID()}`;
---

<figure
  class="slope-graph"
  data-slope-graph
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="slope-graph__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox slope-graph__board"
    style={`height:${height}px`}
    role="img"
    aria-label={description ?? title ?? "Gráfico de pendiente"}
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";

  type GraphType =
    | "slope-types"
    | "constant-slope"
    | "positive-one"
    | "steep-positive"
    | "negative"
    | "horizontal"
    | "vertical"
    | "slope-comparison"
    | "angle";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,
      pan: {
        enabled: interactive,
      },
      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },
      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,
          label: {
            position: "rt",
            offset: [-14, 16],
          },
          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
        y: {
          name: "y",
          withLabel: true,
          label: {
            position: "rt",
            offset: [12, -12],
          },
          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,
      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createSegment(
    board: JXG.Board,
    start: unknown,
    end: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [start, end], {
      straightFirst: false,
      straightLast: false,
      fixed: true,
      highlight: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createSlopeTriangle(
    board: JXG.Board,
    start: [number, number],
    end: [number, number],
    labels: {
      horizontal: string;
      vertical: string;
    },
  ) {
    const corner: [number, number] = [end[0], start[1]];

    createSegment(board, start, corner, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, corner, end, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    board.create("angle", [start, corner, end], {
      radius: 0.4,
      orthoType: "square",
      withLabel: false,
      fixed: true,
      highlight: false,
      fillColor: "#ffffff",
      fillOpacity: 0.85,
      strokeColor: COLORS.gray,
    });

    createText(
      board,
      (start[0] + corner[0]) / 2 - 0.25,
      start[1] - 0.45,
      labels.horizontal,
      {
        color: COLORS.blue,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      corner[0] + 0.25,
      (corner[1] + end[1]) / 2,
      labels.vertical,
      {
        color: COLORS.red,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );
  }

  function drawSlopeTypes(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [-5, -4], [5, 4], {
      strokeColor: COLORS.green,
      strokeWidth: 4,
    });

    createLine(board, [-5, 2], [5, 2], {
      strokeColor: COLORS.blue,
      strokeWidth: 4,
    });

    createLine(board, [-5, 5], [5, -5], {
      strokeColor: COLORS.red,
      strokeWidth: 4,
    });

    createText(board, 3.3, 4.5, "m > 0", {
      color: COLORS.green,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 3.3, 2.45, "m = 0", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 3.3, -4.6, "m < 0", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawConstantSlope(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 13, 8, -2],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 0], [6, 12], {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [0, 0],
      [2, 4],
      {
        horizontal: "Δx = 2",
        vertical: "Δy = 4",
      },
    );

    createSlopeTriangle(
      board,
      [2, 4],
      [5, 10],
      {
        horizontal: "Δx = 3",
        vertical: "Δy = 6",
      },
    );

    createText(board, 4.6, 11.5, "m = 4/2 = 6/3 = 2", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPositiveOne(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 9, 9, -1],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(2, 3)",
        x: 2,
        y: 3,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(6, 7)",
        x: 6,
        y: 7,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 4,
    });

    createSlopeTriangle(
      board,
      [2, 3],
      [6, 7],
      {
        horizontal: "4",
        vertical: "4",
      },
    );

    createText(board, 2.8, 8.2, "m = 4/4 = 1", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawSteepPositive(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 10, 6, -1],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(1, 2)",
        x: 1,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-70, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(3, 8)",
        x: 3,
        y: 8,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 4,
    });

    createSlopeTriangle(
      board,
      [1, 2],
      [3, 8],
      {
        horizontal: "2",
        vertical: "6",
      },
    );

    createText(board, 3.35, 6, "m = 6/2 = 3", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegative(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 8, 7, -3],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(-2, 6)",
        x: -2,
        y: 6,
        color: COLORS.blue,
        labelOffset: [-30, 18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(4, 0)",
        x: 4,
        y: 0,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 4,
    });

    createSlopeTriangle(
      board,
      [-2, 6],
      [4, 0],
      {
        horizontal: "Δx = 6",
        vertical: "Δy = −6",
      },
    );

    createText(board, -0.5, 7.2, "m = −6/6 = −1", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawHorizontal(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 8, 10, -1],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(1, 5)",
        x: 1,
        y: 5,
        color: COLORS.blue,
        labelOffset: [-70, 18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(8, 5)",
        x: 8,
        y: 5,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    createSegment(board, [1, 4.3], [8, 4.3], {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      firstArrow: true,
      lastArrow: true,
    });

    createText(board, 3.7, 3.8, "Δx = 7", {
      color: COLORS.blue,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.45, 6.15, "Δy = 0", {
      color: COLORS.red,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.2, 1.2, "m = 0/7 = 0", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawVertical(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 10, 8, -1],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(4, 2)",
        x: 4,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(4, 8)",
        x: 4,
        y: 8,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createSegment(board, [3.3, 2], [3.3, 8], {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      firstArrow: true,
      lastArrow: true,
    });

    createText(board, 1.4, 5, "Δy = 6", {
      color: COLORS.red,
      cssStyle: "font-weight:700;",
    });

    createText(board, 4.45, 4.9, "Δx = 0", {
      color: COLORS.blue,
      cssStyle: "font-weight:700;",
    });

    createText(board, 0.8, 9.2, "m = 6/0 → indefinida", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawSlopeComparison(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 7, 6, -7],
      interactive,
    );

    board.suspendUpdate();

    const slopes = [
      {
        value: 0.5,
        color: COLORS.blue,
        label: "m = 0.5",
        position: [4, 2.4],
      },
      {
        value: 1,
        color: COLORS.green,
        label: "m = 1",
        position: [3.5, 4],
      },
      {
        value: 2,
        color: COLORS.orange,
        label: "m = 2",
        position: [2.1, 5],
      },
      {
        value: 5,
        color: COLORS.red,
        label: "m = 5",
        position: [0.7, 5.4],
      },
    ];

    for (const slope of slopes) {
      createLine(
        board,
        [0, 0],
        [1, slope.value],
        {
          strokeColor: slope.color,
          strokeWidth: 4,
        },
      );

      createText(
        board,
        slope.position[0],
        slope.position[1],
        slope.label,
        {
          color: slope.color,
          fontSize: 16,
          cssStyle:
            "font-weight:700;background:white;padding:2px 5px;",
        },
      );
    }

    board.unsuspendUpdate();
  }

  function drawAngle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 8, 9, -2],
      interactive,
    );

    board.suspendUpdate();

    const origin = board.create("point", [0, 0], {
      name: "",
      visible: false,
      fixed: true,
    });

    const axisPoint = board.create("point", [4, 0], {
      name: "",
      visible: false,
      fixed: true,
    });

    const linePoint = board.create("point", [4, 4], {
      name: "",
      visible: false,
      fixed: true,
    });

    createLine(board, origin, linePoint, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSegment(board, origin, axisPoint, {
      strokeColor: COLORS.blue,
      strokeWidth: 4,
    });

    createSlopeTriangle(
      board,
      [0, 0],
      [4, 4],
      {
        horizontal: "Δx",
        vertical: "Δy",
      },
    );

    board.create(
      "angle",
      [axisPoint, origin, linePoint],
      {
        radius: 1.4,
        name: "θ",
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.22,
        strokeColor: COLORS.orange,
        label: {
          fontSize: 20,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },
      },
    );

    createText(board, 3.4, 6.5, "m = tan θ", {
      color: COLORS.purple,
      fontSize: 22,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 3.4, 5.7, "θ = 45°  →  m = 1", {
      color: COLORS.dark,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(container: GraphContainer) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );
      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );
      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "slope-types":
        drawSlopeTypes(boardId, interactive);
        break;

      case "constant-slope":
        drawConstantSlope(boardId, interactive);
        break;

      case "positive-one":
        drawPositiveOne(boardId, interactive);
        break;

      case "steep-positive":
        drawSteepPositive(boardId, interactive);
        break;

      case "negative":
        drawNegative(boardId, interactive);
        break;

      case "horizontal":
        drawHorizontal(boardId, interactive);
        break;

      case "vertical":
        drawVertical(boardId, interactive);
        break;

      case "slope-comparison":
        drawSlopeComparison(boardId, interactive);
        break;

      case "angle":
        drawAngle(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-slope-graph]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .slope-graph {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .slope-graph__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .slope-graph__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .slope-graph__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .slope-graph__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .slope-graph {
      margin-block: 1.25rem;
    }

    .slope-graph__board {
      min-height: 390px;
    }
  }
</style>