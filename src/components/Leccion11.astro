---
export type SlopeInterceptGraphType =
  | "slope-comparison"
  | "intercept-comparison"
  | "fractional-construction"
  | "negative-example"
  | "horizontal-lines"
  | "two-points"
  | "parallel-lines"
  | "cost-model";

interface Props {
  type: SlopeInterceptGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `slope-intercept-${type}-${crypto.randomUUID()}`;
---

<figure
  class="slope-intercept"
  data-slope-intercept
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="slope-intercept__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox slope-intercept__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Gráfico de la forma pendiente-ordenada"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "slope-comparison"
    | "intercept-comparison"
    | "fractional-construction"
    | "negative-example"
    | "horizontal-lines"
    | "two-points"
    | "parallel-lines"
    | "cost-model";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
    size?: number;
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    cyan: "#0891b2",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: point.size ?? 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.35,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.9,
        strokeColor: COLORS.gray,
      },
    );
  }

  function createSlopeTriangle(
    board: JXG.Board,
    start: [number, number],
    end: [number, number],
    horizontalLabel: string,
    verticalLabel: string,
    color = COLORS.purple,
  ) {
    const corner: [number, number] = [
      end[0],
      start[1],
    ];

    createSegment(board, start, corner, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, corner, end, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    const startPoint = createHiddenPoint(
      board,
      start[0],
      start[1],
    );

    const cornerPoint = createHiddenPoint(
      board,
      corner[0],
      corner[1],
    );

    const endPoint = createHiddenPoint(
      board,
      end[0],
      end[1],
    );

    createRightAngle(
      board,
      startPoint,
      cornerPoint,
      endPoint,
    );

    createText(
      board,
      (start[0] + corner[0]) / 2 - 0.25,
      start[1] - 0.45,
      horizontalLabel,
      {
        color: COLORS.blue,
        fontSize: 16,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      corner[0] + 0.2,
      (corner[1] + end[1]) / 2,
      verticalLabel,
      {
        color: COLORS.red,
        fontSize: 16,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      (start[0] + end[0]) / 2 - 0.2,
      (start[1] + end[1]) / 2 + 0.45,
      "m",
      {
        color,
        fontSize: 17,
        cssStyle:
          "font-weight:700;background:white;padding:1px 5px;",
      },
    );
  }

  function drawSlopeComparison(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-4, 10, 6, -7],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 2], [1, 5], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, 5], [1, 3], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [0, 2],
      [1, 5],
      "Δx = 1",
      "Δy = 3",
      COLORS.blue,
    );

    createSlopeTriangle(
      board,
      [0, 5],
      [1, 3],
      "Δx = 1",
      "Δy = −2",
      COLORS.red,
    );

    createText(board, -3.5, 8.7, "y = 3x + 2", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 1.6, 7.6, "y = −2x + 5", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -3.5, -5.8, "m = 3", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 1.6, -5.8, "m = −2", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawInterceptComparison(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 8, 6, -7],
      interactive,
    );

    board.suspendUpdate();

    const lines = [
      {
        intercept: 3,
        color: COLORS.blue,
        label: "y = x + 3",
        labelPosition: [-4.8, -1.4],
      },
      {
        intercept: 0,
        color: COLORS.green,
        label: "y = x",
        labelPosition: [-4.8, -4.3],
      },
      {
        intercept: -2,
        color: COLORS.red,
        label: "y = x − 2",
        labelPosition: [2.2, -0.4],
      },
    ];

    for (const item of lines) {
      createLine(
        board,
        [0, item.intercept],
        [1, item.intercept + 1],
        {
          strokeColor: item.color,
          strokeWidth: 5,
        },
      );

      createPoint(
        board,
        {
          name: `(0, ${item.intercept})`,
          x: 0,
          y: item.intercept,
          color: item.color,
          labelOffset: [10, 10],
        },
        false,
      );

      createText(
        board,
        item.labelPosition[0],
        item.labelPosition[1],
        item.label,
        {
          color: item.color,
          fontSize: 17,
          cssStyle:
            "font-weight:700;background:white;padding:3px 6px;",
        },
      );
    }

    createText(board, -5.3, 7.1, "Misma pendiente: m = 1", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawFractionalConstruction(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-3, 8, 9, -3],
      interactive,
    );

    board.suspendUpdate();

    const p0 = createPoint(
      board,
      {
        name: "(0, 1)",
        x: 0,
        y: 1,
        color: COLORS.green,
        labelOffset: [-62, -18],
      },
      interactive,
    );

    const p1 = createPoint(
      board,
      {
        name: "(3, 3)",
        x: 3,
        y: 3,
        color: COLORS.blue,
        labelOffset: [-26, 18],
      },
      interactive,
    );

    const p2 = createPoint(
      board,
      {
        name: "(6, 5)",
        x: 6,
        y: 5,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, p0, p2, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [0, 1],
      [3, 3],
      "3",
      "2",
    );

    createSlopeTriangle(
      board,
      [3, 3],
      [6, 5],
      "3",
      "2",
    );

    createText(board, -2.3, 7.1, "y = ⅔x + 1", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -2.3, 6.2, "b = 1,   m = ⅔", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegativeExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-3, 7, 7, -5],
      interactive,
    );

    board.suspendUpdate();

    const p0 = createPoint(
      board,
      {
        name: "(0, 4)",
        x: 0,
        y: 4,
        color: COLORS.green,
        labelOffset: [-68, 18],
      },
      interactive,
    );

    const p1 = createPoint(
      board,
      {
        name: "(2, 1)",
        x: 2,
        y: 1,
        color: COLORS.blue,
        labelOffset: [10, 15],
      },
      interactive,
    );

    const p2 = createPoint(
      board,
      {
        name: "(4, −2)",
        x: 4,
        y: -2,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    createLine(board, p0, p2, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [0, 4],
      [2, 1],
      "2",
      "−3",
    );

    createSlopeTriangle(
      board,
      [2, 1],
      [4, -2],
      "2",
      "−3",
    );

    createText(board, -2.3, 6.2, "y = −3/2x + 4", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -2.3, 5.35, "b = 4,   m = −3/2", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawHorizontalLines(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 6, 6, -5],
      interactive,
    );

    board.suspendUpdate();

    const lines = [
      {
        y: 3,
        color: COLORS.blue,
        label: "y = 3",
      },
      {
        y: 0,
        color: COLORS.green,
        label: "y = 0",
      },
      {
        y: -2,
        color: COLORS.red,
        label: "y = −2",
      },
    ];

    for (const item of lines) {
      createLine(board, [0, item.y], [1, item.y], {
        strokeColor: item.color,
        strokeWidth: 5,
      });

      createText(board, 3.9, item.y + 0.35, item.label, {
        color: item.color,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:3px 7px;",
      });
    }

    createText(board, -5.2, 5.1, "m = 0", {
      color: COLORS.purple,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(
      board,
      -5.2,
      4.25,
      "Todas son horizontales",
      {
        color: COLORS.dark,
        fontSize: 17,
        cssStyle:
          "font-weight:700;background:white;padding:3px 7px;",
      },
    );

    board.unsuspendUpdate();
  }

  function drawTwoPoints(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 13, 7, -1],
      interactive,
    );

    board.suspendUpdate();

    const intercept = createPoint(
      board,
      {
        name: "(0, 3)",
        x: 0,
        y: 3,
        color: COLORS.green,
        labelOffset: [-68, -18],
      },
      interactive,
    );

    const a = createPoint(
      board,
      {
        name: "A(1, 5)",
        x: 1,
        y: 5,
        color: COLORS.blue,
        labelOffset: [-72, 18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(4, 11)",
        x: 4,
        y: 11,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, intercept, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [1, 5],
      [4, 11],
      "Δx = 3",
      "Δy = 6",
    );

    createSegment(board, [0, 3], [0, 0], {
      strokeColor: COLORS.green,
      strokeWidth: 2,
      dash: 2,
    });

    createText(board, 4.4, 8, "m = 6/3 = 2", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -1.2, 12.2, "y = 2x + 3", {
      color: COLORS.dark,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawParallelLines(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 10, 5, -10],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 2], [1, 5], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, -6], [1, -3], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createPoint(
      board,
      {
        name: "b₁ = 2",
        x: 0,
        y: 2,
        color: COLORS.blue,
        labelOffset: [10, 10],
      },
      false,
    );

    createPoint(
      board,
      {
        name: "b₂ = −6",
        x: 0,
        y: -6,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      false,
    );

    createText(board, -4.2, 8.8, "y = 3x + 2", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 0.6, -7.7, "y = 3x − 6", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -4.2, -9, "m₁ = m₂ = 3", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawCostModel(
    boardId: string,
    interactive: boolean,
  ) {
    const board = JXG.JSXGraph.initBoard(boardId, {
      boundingbox: [-1, 18, 8, -2],
      axis: true,
      grid: true,
      keepAspectRatio: false,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "Distancia x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-80, 18],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "Costo C",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 2,
            minorTicks: 0,
          },
        },
      },
    });

    board.suspendUpdate();

    const initial = createPoint(
      board,
      {
        name: "Tarifa inicial (0, 4)",
        x: 0,
        y: 4,
        color: COLORS.green,
        labelOffset: [10, 10],
      },
      interactive,
    );

    const oneUnit = createPoint(
      board,
      {
        name: "(1, 6)",
        x: 1,
        y: 6,
        color: COLORS.blue,
        labelOffset: [10, 10],
      },
      interactive,
    );

    const fiveUnits = createPoint(
      board,
      {
        name: "(5, 14)",
        x: 5,
        y: 14,
        color: COLORS.red,
        labelOffset: [10, 10],
      },
      interactive,
    );

    createLine(board, initial, fiveUnits, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [0, 4],
      [1, 6],
      "1 km",
      "+2",
    );

    createText(board, 3.8, 16.5, "C = 2x + 4", {
      color: COLORS.purple,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 3.8, 15.4, "m = 2 por unidad", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 3.8, 14.4, "b = 4 inicial", {
      color: COLORS.green,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "slope-comparison":
        drawSlopeComparison(boardId, interactive);
        break;

      case "intercept-comparison":
        drawInterceptComparison(
          boardId,
          interactive,
        );
        break;

      case "fractional-construction":
        drawFractionalConstruction(
          boardId,
          interactive,
        );
        break;

      case "negative-example":
        drawNegativeExample(boardId, interactive);
        break;

      case "horizontal-lines":
        drawHorizontalLines(boardId, interactive);
        break;

      case "two-points":
        drawTwoPoints(boardId, interactive);
        break;

      case "parallel-lines":
        drawParallelLines(boardId, interactive);
        break;

      case "cost-model":
        drawCostModel(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-slope-intercept]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
