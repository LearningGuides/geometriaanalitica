---
export type PointSlopeGraphType =
  | "formula-deduction"
  | "positive-slope"
  | "negative-slope"
  | "two-points"
  | "horizontal-line"
  | "graph-construction";

interface Props {
  type: PointSlopeGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `point-slope-${type}-${crypto.randomUUID()}`;
---

<figure
  class="point-slope-graph"
  data-point-slope-graph
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="point-slope-graph__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox point-slope-graph__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Gráfico de la forma punto-pendiente"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "formula-deduction"
    | "positive-slope"
    | "negative-slope"
    | "two-points"
    | "horizontal-line"
    | "graph-construction";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
    size?: number;
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: point.size ?? 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.4,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.9,
        strokeColor: COLORS.gray,
      },
    );
  }

  function createSlopeTriangle(
    board: JXG.Board,
    start: [number, number],
    end: [number, number],
    horizontalLabel: string,
    verticalLabel: string,
  ) {
    const corner: [number, number] = [
      end[0],
      start[1],
    ];

    createSegment(board, start, corner, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, corner, end, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    const startPoint = createHiddenPoint(
      board,
      start[0],
      start[1],
    );

    const cornerPoint = createHiddenPoint(
      board,
      corner[0],
      corner[1],
    );

    const endPoint = createHiddenPoint(
      board,
      end[0],
      end[1],
    );

    createRightAngle(
      board,
      startPoint,
      cornerPoint,
      endPoint,
    );

    createText(
      board,
      (start[0] + corner[0]) / 2 - 0.3,
      start[1] - 0.45,
      horizontalLabel,
      {
        color: COLORS.blue,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      corner[0] + 0.25,
      (corner[1] + end[1]) / 2,
      verticalLabel,
      {
        color: COLORS.red,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );
  }

  function drawFormulaDeduction(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 9, 11, -2],
      interactive,
    );

    board.suspendUpdate();

    const fixedPoint = createPoint(
      board,
      {
        name: "P₁(x₁, y₁)",
        x: 2,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-96, -18],
      },
      interactive,
    );

    const variablePoint = createPoint(
      board,
      {
        name: "P(x, y)",
        x: 8,
        y: 6,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, fixedPoint, variablePoint, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [2, 2],
      [8, 6],
      "x − x₁",
      "y − y₁",
    );

    createText(
      board,
      2.8,
      8,
      "m = (y − y₁) / (x − x₁)",
      {
        color: COLORS.purple,
        fontSize: 20,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    createText(
      board,
      3.25,
      7.15,
      "y − y₁ = m(x − x₁)",
      {
        color: COLORS.dark,
        fontSize: 19,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    board.unsuspendUpdate();
  }

  function drawPositiveSlope(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 9, 6, -2],
      interactive,
    );

    board.suspendUpdate();

    const p = createPoint(
      board,
      {
        name: "P(2, 3)",
        x: 2,
        y: 3,
        color: COLORS.green,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const secondPoint = createPoint(
      board,
      {
        name: "Q(3, 7)",
        x: 3,
        y: 7,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, p, secondPoint, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [2, 3],
      [3, 7],
      "Δx = 1",
      "Δy = 4",
    );

    createText(board, 3.35, 5.2, "m = 4/1 = 4", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -0.35, 8.25, "y − 3 = 4(x − 2)", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegativeSlope(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 8, 6, -4],
      interactive,
    );

    board.suspendUpdate();

    const p = createPoint(
      board,
      {
        name: "P(−1, 5)",
        x: -1,
        y: 5,
        color: COLORS.green,
        labelOffset: [-82, 18],
      },
      interactive,
    );

    const q = createPoint(
      board,
      {
        name: "Q(0, 3)",
        x: 0,
        y: 3,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    const r = createPoint(
      board,
      {
        name: "R(1, 1)",
        x: 1,
        y: 1,
        color: COLORS.orange,
        labelOffset: [10, -18],
      },
      interactive,
    );

    createLine(board, p, q, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [-1, 5],
      [0, 3],
      "Δx = 1",
      "Δy = −2",
    );

    createSegment(board, q, r, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createText(board, 0.45, 4.3, "m = −2", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -4.2, 7.2, "y − 5 = −2(x + 1)", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawTwoPoints(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 12, 8, -1],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(1, 2)",
        x: 1,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(5, 10)",
        x: 5,
        y: 10,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [1, 2],
      [5, 10],
      "Δx = 4",
      "Δy = 8",
    );

    createText(board, 5.4, 6.2, "m = 8/4 = 2", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -0.2, 11.2, "y − 2 = 2(x − 1)", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawHorizontalLine(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-3, 9, 10, -1],
      interactive,
    );

    board.suspendUpdate();

    const p = createPoint(
      board,
      {
        name: "P(4, 6)",
        x: 4,
        y: 6,
        color: COLORS.green,
        labelOffset: [-28, 18],
      },
      interactive,
    );

    createLine(board, [0, 6], [1, 6], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    const samplePoints = [
      [-1, 6],
      [1, 6],
      [7, 6],
      [9, 6],
    ];

    for (const coordinates of samplePoints) {
      board.create("point", coordinates, {
        name: "",
        size: 3,
        fixed: true,
        strokeColor: COLORS.blue,
        fillColor: COLORS.blue,
        highlight: false,
      });
    }

    createText(board, 6.7, 6.45, "y = 6", {
      color: COLORS.blue,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -2.2, 8.2, "m = 0", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -2.2, 7.35, "y − 6 = 0(x − 4)", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawGraphConstruction(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 7, 9, -5],
      interactive,
    );

    board.suspendUpdate();

    const left = createPoint(
      board,
      {
        name: "A(2, 4)",
        x: 2,
        y: 4,
        color: COLORS.blue,
        labelOffset: [-74, 18],
      },
      interactive,
    );

    const center = createPoint(
      board,
      {
        name: "P(4, 1)",
        x: 4,
        y: 1,
        color: COLORS.green,
        labelOffset: [-30, 18],
      },
      interactive,
    );

    const right = createPoint(
      board,
      {
        name: "B(6, −2)",
        x: 6,
        y: -2,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    createLine(board, left, right, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSlopeTriangle(
      board,
      [4, 1],
      [6, -2],
      "Δx = 2",
      "Δy = −3",
    );

    createSlopeTriangle(
      board,
      [2, 4],
      [4, 1],
      "Δx = 2",
      "Δy = −3",
    );

    createText(board, -0.3, 6.15, "y − 1 = −3/2(x − 4)", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 6.35, 3.8, "m = −3/2", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "formula-deduction":
        drawFormulaDeduction(boardId, interactive);
        break;

      case "positive-slope":
        drawPositiveSlope(boardId, interactive);
        break;

      case "negative-slope":
        drawNegativeSlope(boardId, interactive);
        break;

      case "two-points":
        drawTwoPoints(boardId, interactive);
        break;

      case "horizontal-line":
        drawHorizontalLine(boardId, interactive);
        break;

      case "graph-construction":
        drawGraphConstruction(
          boardId,
          interactive,
        );
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-point-slope-graph]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .point-slope-graph {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .point-slope-graph__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .point-slope-graph__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .point-slope-graph__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .point-slope-graph__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .point-slope-graph {
      margin-block: 1.25rem;
    }

    .point-slope-graph__board {
      min-height: 390px;
    }
  }
</style>