---
export type SymmetricLineGraphType =
  | "vector-parameter"
  | "direction-slope"
  | "symmetric-example"
  | "negative-direction"
  | "special-cases";

interface Props {
  type: SymmetricLineGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `symmetric-line-${type}-${crypto.randomUUID()}`;
---

<figure
  class="symmetric-line"
  data-symmetric-line
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="symmetric-line__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox symmetric-line__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Gráfico de la forma simétrica de una recta"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "vector-parameter"
    | "direction-slope"
    | "symmetric-example"
    | "negative-direction"
    | "special-cases";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
    size?: number;
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    cyan: "#0891b2",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: point.size ?? 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createArrow(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("arrow", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.green,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.4,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.9,
        strokeColor: COLORS.gray,
      },
    );
  }

  function createDirectionTriangle(
    board: JXG.Board,
    start: [number, number],
    end: [number, number],
    horizontalLabel: string,
    verticalLabel: string,
  ) {
    const corner: [number, number] = [
      end[0],
      start[1],
    ];

    createSegment(board, start, corner, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, corner, end, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    const startPoint = createHiddenPoint(
      board,
      start[0],
      start[1],
    );

    const cornerPoint = createHiddenPoint(
      board,
      corner[0],
      corner[1],
    );

    const endPoint = createHiddenPoint(
      board,
      end[0],
      end[1],
    );

    createRightAngle(
      board,
      startPoint,
      cornerPoint,
      endPoint,
    );

    createText(
      board,
      (start[0] + corner[0]) / 2 - 0.3,
      start[1] - 0.45,
      horizontalLabel,
      {
        color: COLORS.blue,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      corner[0] + 0.25,
      (corner[1] + end[1]) / 2,
      verticalLabel,
      {
        color: COLORS.red,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );
  }

  function drawVectorParameter(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 9, 10, -6],
      interactive,
    );

    board.suspendUpdate();

    const base = createPoint(
      board,
      {
        name: "P(x₁, y₁)",
        x: 1,
        y: 1,
        color: COLORS.green,
        labelOffset: [-84, -18],
      },
      interactive,
    );

    const negative = createPoint(
      board,
      {
        name: "t = −1",
        x: -2,
        y: -1,
        color: COLORS.red,
        labelOffset: [-68, -18],
      },
      interactive,
    );

    const one = createPoint(
      board,
      {
        name: "t = 1",
        x: 4,
        y: 3,
        color: COLORS.blue,
        labelOffset: [10, 12],
      },
      interactive,
    );

    const two = createPoint(
      board,
      {
        name: "t = 2",
        x: 7,
        y: 5,
        color: COLORS.purple,
        labelOffset: [10, 12],
      },
      interactive,
    );

    createLine(board, negative, two, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createArrow(board, base, one, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    createArrow(board, base, two, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createArrow(board, base, negative, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createDirectionTriangle(
      board,
      [1, 1],
      [4, 3],
      "a",
      "b",
    );

    createText(board, -6.2, 8, "v = (a, b)", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(
      board,
      -6.2,
      7.1,
      "x = x₁ + at,   y = y₁ + bt",
      {
        color: COLORS.dark,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    createText(
      board,
      -6.2,
      6.15,
      "(x − x₁)/a = (y − y₁)/b",
      {
        color: COLORS.purple,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    board.unsuspendUpdate();
  }

  function drawDirectionSlope(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-3, 7, 9, -3],
      interactive,
    );

    board.suspendUpdate();

    const start = createPoint(
      board,
      {
        name: "P",
        x: 0,
        y: 1,
        color: COLORS.green,
        labelOffset: [-26, -18],
      },
      interactive,
    );

    const end = createPoint(
      board,
      {
        name: "Q",
        x: 4,
        y: 3,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, start, end, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createArrow(board, start, end, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    createDirectionTriangle(
      board,
      [0, 1],
      [4, 3],
      "a = 4",
      "b = 2",
    );

    createText(board, 4.45, 4.2, "v = (4, 2)", {
      color: COLORS.green,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.8, 5.7, "m = b/a = 2/4 = 1/2", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawSymmetricExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-4, 6, 8, -7],
      interactive,
    );

    board.suspendUpdate();

    const previous = createPoint(
      board,
      {
        name: "A(−1, −5)",
        x: -1,
        y: -5,
        color: COLORS.red,
        labelOffset: [-86, -18],
      },
      interactive,
    );

    const center = createPoint(
      board,
      {
        name: "P(2, −1)",
        x: 2,
        y: -1,
        color: COLORS.green,
        labelOffset: [-72, 18],
      },
      interactive,
    );

    const next = createPoint(
      board,
      {
        name: "B(5, 3)",
        x: 5,
        y: 3,
        color: COLORS.blue,
      },
      interactive,
    );

    createLine(board, previous, next, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createArrow(board, previous, center, {
      strokeColor: COLORS.orange,
      strokeWidth: 4,
    });

    createArrow(board, center, next, {
      strokeColor: COLORS.green,
      strokeWidth: 4,
    });

    createDirectionTriangle(
      board,
      [2, -1],
      [5, 3],
      "3",
      "4",
    );

    createText(
      board,
      -3.35,
      5.25,
      "(x − 2)/3 = (y + 1)/4",
      {
        color: COLORS.purple,
        fontSize: 20,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    createText(board, -3.35, 4.35, "v = (3, 4)", {
      color: COLORS.green,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegativeDirection(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 9, 8, -2],
      interactive,
    );

    board.suspendUpdate();

    const previous = createPoint(
      board,
      {
        name: "A(−2, 7)",
        x: -2,
        y: 7,
        color: COLORS.blue,
        labelOffset: [-28, 18],
      },
      interactive,
    );

    const center = createPoint(
      board,
      {
        name: "P(1, 5)",
        x: 1,
        y: 5,
        color: COLORS.green,
        labelOffset: [-72, 18],
      },
      interactive,
    );

    const next = createPoint(
      board,
      {
        name: "B(4, 3)",
        x: 4,
        y: 3,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, previous, next, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createArrow(board, previous, center, {
      strokeColor: COLORS.blue,
      strokeWidth: 4,
    });

    createArrow(board, center, next, {
      strokeColor: COLORS.red,
      strokeWidth: 4,
    });

    createDirectionTriangle(
      board,
      [1, 5],
      [4, 3],
      "3",
      "−2",
    );

    createText(
      board,
      -4.3,
      8.35,
      "(x − 1)/3 = (y − 5)/(−2)",
      {
        color: COLORS.purple,
        fontSize: 19,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    createText(board, 4.45, 6.3, "v = (3, −2)", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 4.45, 5.45, "m = −2/3", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawSpecialCases(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 8, 7, -5],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 5], [1, 5], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [-2, 0], [-2, 1], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createPoint(
      board,
      {
        name: "(3, 5)",
        x: 3,
        y: 5,
        color: COLORS.blue,
        labelOffset: [10, 12],
      },
      false,
    );

    createPoint(
      board,
      {
        name: "(−2, 4)",
        x: -2,
        y: 4,
        color: COLORS.red,
        labelOffset: [-82, 12],
      },
      false,
    );

    createText(board, 3.6, 5.45, "y = 5", {
      color: COLORS.blue,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -3.35, 6.65, "x = −2", {
      color: COLORS.red,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(
      board,
      0.3,
      -3.7,
      "No se permiten denominadores iguales a cero",
      {
        color: COLORS.purple,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    createText(board, 0.3, -2.75, "Horizontal: b = 0", {
      color: COLORS.blue,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 0.3, -1.9, "Vertical: a = 0", {
      color: COLORS.red,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "vector-parameter":
        drawVectorParameter(boardId, interactive);
        break;

      case "direction-slope":
        drawDirectionSlope(boardId, interactive);
        break;

      case "symmetric-example":
        drawSymmetricExample(boardId, interactive);
        break;

      case "negative-direction":
        drawNegativeDirection(boardId, interactive);
        break;

      case "special-cases":
        drawSpecialCases(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-symmetric-line]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .symmetric-line {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .symmetric-line__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .symmetric-line__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .symmetric-line__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .symmetric-line__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .symmetric-line {
      margin-block: 1.25rem;
    }

    .symmetric-line__board {
      min-height: 390px;
    }
  }
</style>