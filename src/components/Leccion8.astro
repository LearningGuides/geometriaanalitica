---
export type ParallelGraphType =
  | "constant-distance"
  | "same-angle"
  | "equation-example"
  | "points-example"
  | "vertical-lines"
  | "parallel-construction"
  | "general-distance";

interface Props {
  type: ParallelGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `parallel-lines-${type}-${crypto.randomUUID()}`;
---

<figure
  class="parallel-lines"
  data-parallel-lines
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="parallel-lines__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox parallel-lines__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ?? title ?? "Gráfico de rectas paralelas"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "constant-distance"
    | "same-angle"
    | "equation-example"
    | "points-example"
    | "vertical-lines"
    | "parallel-construction"
    | "general-distance";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.4,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.9,
        strokeColor: COLORS.gray,
      },
    );
  }

  function createAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
    name: string,
    color: string,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 1,
        name,
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: color,
        fillOpacity: 0.18,
        strokeColor: color,

        label: {
          fontSize: 18,
          color,
          cssStyle: "font-weight:700;",
        },
      },
    );
  }

  function drawConstantDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 8, 7, -8],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 2], [1, 3], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, -2], [1, -1], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    const connectors = [-4, -1, 2, 5];

    for (const x of connectors) {
      const upper = [x, x + 2];
      const lower = [x, x - 2];

      createSegment(board, lower, upper, {
        strokeColor: COLORS.green,
        strokeWidth: 3,
      });

      const horizontalReference =
        createHiddenPoint(board, x + 1, x - 2);

      const lowerPoint =
        createHiddenPoint(board, x, x - 2);

      const upperPoint =
        createHiddenPoint(board, x, x + 2);

      createRightAngle(
        board,
        horizontalReference,
        lowerPoint,
        upperPoint,
      );
    }

    createText(board, -5.6, 7, "r₁", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.8, 0.8, "r₂", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, -5.5, -7, "Distancia constante", {
      color: COLORS.green,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawSameAngle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 8, 7, -6],
      interactive,
    );

    board.suspendUpdate();

    const lowerOrigin =
      createHiddenPoint(board, -3, -2);

    const upperOrigin =
      createHiddenPoint(board, -3, 2);

    const lowerDirection =
      createHiddenPoint(board, 1, 2);

    const upperDirection =
      createHiddenPoint(board, 1, 6);

    const lowerAxis =
      createHiddenPoint(board, 1, -2);

    const upperAxis =
      createHiddenPoint(board, 1, 2);

    createLine(board, lowerOrigin, lowerDirection, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createLine(board, upperOrigin, upperDirection, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createSegment(board, lowerOrigin, lowerAxis, {
      strokeColor: COLORS.gray,
      strokeWidth: 2,
      dash: 2,
    });

    createSegment(board, upperOrigin, upperAxis, {
      strokeColor: COLORS.gray,
      strokeWidth: 2,
      dash: 2,
    });

    createAngle(
      board,
      lowerAxis,
      lowerOrigin,
      lowerDirection,
      "θ",
      COLORS.red,
    );

    createAngle(
      board,
      upperAxis,
      upperOrigin,
      upperDirection,
      "θ",
      COLORS.blue,
    );

    createText(board, -1.6, 7, "θ₁ = θ₂", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -1.8, 6.2, "m₁ = m₂", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawEquationExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 10, 5, -10],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 2], [1, 5], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, -5], [1, -2], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createText(board, -3.4, 8.5, "r₁: y = 3x + 2", {
      color: COLORS.blue,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 0.8, -6.6, "r₂: y = 3x − 5", {
      color: COLORS.red,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -4.2, -9, "m₁ = m₂ = 3", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPointsExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 11, 7, -2],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(1, 2)",
        x: 1,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(5, 6)",
        x: 5,
        y: 6,
        color: COLORS.blue,
      },
      interactive,
    );

    const c = createPoint(
      board,
      {
        name: "C(-2, 4)",
        x: -2,
        y: 4,
        color: COLORS.red,
        labelOffset: [-82, 18],
      },
      interactive,
    );

    const d = createPoint(
      board,
      {
        name: "D(3, 9)",
        x: 3,
        y: 9,
        color: COLORS.red,
      },
      interactive,
    );

    createLine(board, a, b, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, c, d, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createText(board, -4.2, 10, "m₁ = 4/4 = 1", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 1, 10, "m₂ = 5/5 = 1", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawVerticalLines(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 8, 6, -8],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [-2, 0], [-2, 1], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [3, 0], [3, 1], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    const levels = [-5, -1, 3, 6];

    for (const y of levels) {
      createSegment(board, [-2, y], [3, y], {
        strokeColor: COLORS.green,
        strokeWidth: 3,
      });
    }

    createText(board, -3.4, 7, "x = −2", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 3.35, 7, "x = 3", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -1, -7, "Separación = 5", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawParallelConstruction(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 10, 6, -9],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 3], [1, 5], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, -4], [1, -2], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createPoint(
      board,
      {
        name: "P(1, −2)",
        x: 1,
        y: -2,
        color: COLORS.green,
        labelOffset: [10, -18],
      },
      interactive,
    );

    createText(board, -4.5, 8.7, "Original: y = 2x + 3", {
      color: COLORS.blue,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -4.5, -7.5, "Paralela: y = 2x − 4", {
      color: COLORS.red,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 1.6, 7, "m = 2", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawGeneralDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-8, 8, 8, -8],
      interactive,
    );

    board.suspendUpdate();

    // 2x - 3y + 4 = 0  → y = (2/3)x + 4/3
    createLine(
      board,
      [0, 4 / 3],
      [3, 10 / 3],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    // 2x - 3y - 8 = 0 → y = (2/3)x - 8/3
    createLine(
      board,
      [0, -8 / 3],
      [3, -2 / 3],
      {
        strokeColor: COLORS.red,
        strokeWidth: 5,
      },
    );

    const lower = createHiddenPoint(
      board,
      -12 / 13,
      -44 / 13,
    );

    const upper = createHiddenPoint(
      board,
      24 / 13,
      20 / 13,
    );

    createSegment(board, lower, upper, {
      strokeColor: COLORS.green,
      strokeWidth: 4,
      firstArrow: true,
      lastArrow: true,
    });

    const directionReference = createHiddenPoint(
      board,
      lower.X() + 3,
      lower.Y() + 2,
    );

    createRightAngle(
      board,
      directionReference,
      lower,
      upper,
    );

    createText(board, -7.1, 6.8, "2x − 3y + 4 = 0", {
      color: COLORS.blue,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 1.4, -5.8, "2x − 3y − 8 = 0", {
      color: COLORS.red,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -1.3, -0.7, "d = 12/√13", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "constant-distance":
        drawConstantDistance(boardId, interactive);
        break;

      case "same-angle":
        drawSameAngle(boardId, interactive);
        break;

      case "equation-example":
        drawEquationExample(boardId, interactive);
        break;

      case "points-example":
        drawPointsExample(boardId, interactive);
        break;

      case "vertical-lines":
        drawVerticalLines(boardId, interactive);
        break;

      case "parallel-construction":
        drawParallelConstruction(
          boardId,
          interactive,
        );
        break;

      case "general-distance":
        drawGeneralDistance(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-parallel-lines]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .parallel-lines {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .parallel-lines__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .parallel-lines__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .parallel-lines__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .parallel-lines__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .parallel-lines {
      margin-block: 1.25rem;
    }

    .parallel-lines__board {
      min-height: 390px;
    }
  }
</style>