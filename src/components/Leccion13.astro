---
export type PointLineDistanceGraphType =
  | "minimum-distance"
  | "normal-projection"
  | "formula-example"
  | "point-on-line"
  | "horizontal-line"
  | "vertical-line";

interface Props {
  type: PointLineDistanceGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `point-line-distance-${type}-${crypto.randomUUID()}`;
---

<figure
  class="point-line-distance"
  data-point-line-distance
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="point-line-distance__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox point-line-distance__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Distancia de un punto a una recta"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "minimum-distance"
    | "normal-projection"
    | "formula-example"
    | "point-on-line"
    | "horizontal-line"
    | "vertical-line";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
    size?: number;
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    lightGray: "#cbd5e1",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: point.size ?? 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createArrow(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("arrow", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.green,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.45,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.9,
        strokeColor: COLORS.gray,
      },
    );
  }

  function drawMinimumDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 8, 8, -6],
      interactive,
    );

    board.suspendUpdate();

    const line = createLine(
      board,
      [-5, -2],
      [5, 3],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    const point = createPoint(
      board,
      {
        name: "P",
        x: -1,
        y: 6,
        color: COLORS.red,
        labelOffset: [-26, 18],
      },
      interactive,
    );

    const foot = board.create(
      "perpendicularpoint",
      [point, line],
      {
        name: "H",
        size: 4,
        fixed: true,
        highlight: false,
        strokeColor: COLORS.green,
        fillColor: COLORS.green,

        label: {
          offset: [8, -18],
          fontSize: 15,
          color: COLORS.dark,
          cssStyle: "font-weight:700;",
        },
      },
    );

    const otherTargets = [
      [-4, -1.5],
      [2, 1.5],
      [5, 3],
    ];

    for (const target of otherTargets) {
      createSegment(board, point, target, {
        strokeColor: COLORS.lightGray,
        strokeWidth: 2,
        dash: 2,
      });
    }

    createSegment(board, point, foot, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    const lineReference = createHiddenPoint(
      board,
      foot.X() + 2,
      foot.Y() + 1,
    );

    createRightAngle(
      board,
      point,
      foot,
      lineReference,
    );

    createText(board, 0.3, 4.2, "Distancia mínima", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -6.2, 7.1, "El segmento perpendicular es el más corto", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawNormalProjection(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 8, 8, -6],
      interactive,
    );

    board.suspendUpdate();

    const line = createLine(
      board,
      [-5, -1],
      [5, 4],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    const point = createPoint(
      board,
      {
        name: "P(x₀, y₀)",
        x: -2,
        y: 6,
        color: COLORS.red,
        labelOffset: [-98, 18],
      },
      interactive,
    );

    const foot = board.create(
      "perpendicularpoint",
      [point, line],
      {
        name: "H",
        size: 4,
        fixed: true,
        highlight: false,
        strokeColor: COLORS.green,
        fillColor: COLORS.green,

        label: {
          offset: [8, -18],
          fontSize: 15,
          color: COLORS.dark,
          cssStyle: "font-weight:700;",
        },
      },
    );

    createSegment(board, point, foot, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    const normalEnd = createHiddenPoint(
      board,
      foot.X() - 1.5,
      foot.Y() + 3,
    );

    createArrow(board, foot, normalEnd, {
      strokeColor: COLORS.orange,
      strokeWidth: 5,
    });

    const lineReference = createHiddenPoint(
      board,
      foot.X() + 2,
      foot.Y() + 1,
    );

    createRightAngle(
      board,
      point,
      foot,
      lineReference,
    );

    createText(
      board,
      normalEnd.X() - 1.1,
      normalEnd.Y() + 0.4,
      "n = (A, B)",
      {
        color: COLORS.orange,
        fontSize: 19,
        cssStyle:
          "font-weight:700;background:white;padding:3px 7px;",
      },
    );

    createText(board, 0.8, 5.2, "Proyección ortogonal", {
      color: COLORS.green,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(
      board,
      -6.1,
      7.1,
      "d = |Ax₀ + By₀ + C| / √(A² + B²)",
      {
        color: COLORS.purple,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    board.unsuspendUpdate();
  }

  function drawFormulaExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 7, 8, -5],
      interactive,
    );

    board.suspendUpdate();

    // 3x + 4y - 10 = 0
    const line = createLine(
      board,
      [0, 2.5],
      [4, -0.5],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    const point = createPoint(
      board,
      {
        name: "P(2, 3)",
        x: 2,
        y: 3,
        color: COLORS.red,
        labelOffset: [-74, 18],
      },
      interactive,
    );

    const foot = board.create(
      "perpendicularpoint",
      [point, line],
      {
        name: "H",
        size: 4,
        fixed: true,
        highlight: false,
        strokeColor: COLORS.green,
        fillColor: COLORS.green,

        label: {
          offset: [8, -18],
          fontSize: 15,
          color: COLORS.dark,
          cssStyle: "font-weight:700;",
        },
      },
    );

    createSegment(board, point, foot, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    const lineReference = createHiddenPoint(
      board,
      foot.X() + 4,
      foot.Y() - 3,
    );

    createRightAngle(
      board,
      point,
      foot,
      lineReference,
    );

    createText(board, -4.3, 6.1, "3x + 4y − 10 = 0", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 2.7, 2.4, "d = 8/5 = 1.6", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPointOnLine(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 7, 7, -5],
      interactive,
    );

    board.suspendUpdate();

    // 2x + y - 4 = 0 → y = -2x + 4
    createLine(board, [0, 4], [1, 2], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createPoint(
      board,
      {
        name: "P(1, 2)",
        x: 1,
        y: 2,
        color: COLORS.green,
        labelOffset: [10, 14],
      },
      interactive,
    );

    createText(board, -4.2, 6.1, "2x + y − 4 = 0", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 2.1, 3.2, "2(1) + 2 − 4 = 0", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.1, 2.25, "d = 0", {
      color: COLORS.green,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawHorizontalLine(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-3, 7, 8, -5],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 4], [1, 4], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    const point = createPoint(
      board,
      {
        name: "P(3, −2)",
        x: 3,
        y: -2,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    const foot = createPoint(
      board,
      {
        name: "H(3, 4)",
        x: 3,
        y: 4,
        color: COLORS.green,
        labelOffset: [10, 12],
      },
      false,
    );

    createSegment(board, point, foot, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
      firstArrow: true,
      lastArrow: true,
    });

    createRightAngle(
      board,
      createHiddenPoint(board, 4, 4),
      foot,
      point,
    );

    createText(board, 5, 4.4, "y = 4", {
      color: COLORS.blue,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 3.35, 1, "d = 6", {
      color: COLORS.green,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -2.2, 6.1, "|4 − (−2)| = 6", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawVerticalLine(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 7, 8, -5],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [-3, 0], [-3, 1], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    const point = createPoint(
      board,
      {
        name: "P(5, 2)",
        x: 5,
        y: 2,
        color: COLORS.red,
        labelOffset: [10, 12],
      },
      interactive,
    );

    const foot = createPoint(
      board,
      {
        name: "H(−3, 2)",
        x: -3,
        y: 2,
        color: COLORS.green,
        labelOffset: [-88, 12],
      },
      false,
    );

    createSegment(board, foot, point, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
      firstArrow: true,
      lastArrow: true,
    });

    createRightAngle(
      board,
      createHiddenPoint(board, -3, 3),
      foot,
      point,
    );

    createText(board, -4.8, 6.1, "x = −3", {
      color: COLORS.blue,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 0.2, 2.45, "d = 8", {
      color: COLORS.green,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -1.5, 6.1, "|5 − (−3)| = 8", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "minimum-distance":
        drawMinimumDistance(boardId, interactive);
        break;

      case "normal-projection":
        drawNormalProjection(boardId, interactive);
        break;

      case "formula-example":
        drawFormulaExample(boardId, interactive);
        break;

      case "point-on-line":
        drawPointOnLine(boardId, interactive);
        break;

      case "horizontal-line":
        drawHorizontalLine(boardId, interactive);
        break;

      case "vertical-line":
        drawVerticalLine(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-point-line-distance]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .point-line-distance {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .point-line-distance__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .point-line-distance__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .point-line-distance__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .point-line-distance__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .point-line-distance {
      margin-block: 1.25rem;
    }

    .point-line-distance__board {
      min-height: 390px;
    }
  }
</style>