---
export type InclinationGraphType =
  | "angle-types"
  | "tangent-relation"
  | "angle-45"
  | "angle-positive"
  | "fraction-comparison"
  | "negative-angle"
  | "vertical-angle"
  | "angle-comparison";

interface Props {
  type: InclinationGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `inclination-angle-${type}-${crypto.randomUUID()}`;
---

<figure
  class="inclination-angle"
  data-inclination-angle
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="inclination-angle__caption">
        <strong>{title}</strong>

        {
          description && (
            <span>{description}</span>
          )
        }
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox inclination-angle__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description
        ?? title
        ?? "Ángulo de inclinación de una recta"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "angle-types"
    | "tangent-relation"
    | "angle-45"
    | "angle-positive"
    | "fraction-comparison"
    | "negative-angle"
    | "vertical-angle"
    | "angle-comparison";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface TextOptions {
    color?: string;
    fontSize?: number;
    cssStyle?: string;
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    cyan: "#0891b2",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: TextOptions = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: options.fontSize ?? 16,
      color: options.color ?? COLORS.dark,
      cssStyle: options.cssStyle,
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
    label: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 1.1,
        name: label,
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.2,
        strokeColor: COLORS.orange,

        label: {
          fontSize: 18,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },

        ...options,
      },
    );
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.4,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.85,
        strokeColor: COLORS.gray,
      },
    );
  }

  function createSlopeTriangle(
    board: JXG.Board,
    endX: number,
    endY: number,
    horizontalLabel: string,
    verticalLabel: string,
  ) {
    const origin = createHiddenPoint(board, 0, 0);
    const corner = createHiddenPoint(board, endX, 0);
    const end = createHiddenPoint(board, endX, endY);

    createSegment(board, origin, corner, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, corner, end, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createRightAngle(board, origin, corner, end);

    createText(
      board,
      endX / 2 - 0.3,
      -0.5,
      horizontalLabel,
      {
        color: COLORS.blue,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );

    createText(
      board,
      endX + 0.25,
      endY / 2,
      verticalLabel,
      {
        color: COLORS.red,
        fontSize: 17,
        cssStyle: "font-weight:700;",
      },
    );

    return {
      origin,
      corner,
      end,
    };
  }

  function drawAngleTypes(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const positiveAxis = createHiddenPoint(board, 4.5, 0);

    const horizontal = createHiddenPoint(board, 5, 0);
    const increasing = createHiddenPoint(board, 4, 3);
    const vertical = createHiddenPoint(board, 0, 5);
    const decreasing = createHiddenPoint(board, -4, 3);

    createLine(board, origin, horizontal, {
      strokeColor: COLORS.blue,
    });

    createLine(board, origin, increasing, {
      strokeColor: COLORS.green,
    });

    createLine(board, origin, vertical, {
      strokeColor: COLORS.orange,
    });

    createLine(board, origin, decreasing, {
      strokeColor: COLORS.red,
    });

    createAngle(
      board,
      positiveAxis,
      origin,
      increasing,
      "θ",
      {
        radius: 1.2,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createAngle(
      board,
      positiveAxis,
      origin,
      vertical,
      "90°",
      {
        radius: 1.8,
        orthoType: "square",
        fillColor: COLORS.orange,
        strokeColor: COLORS.orange,
      },
    );

    createAngle(
      board,
      positiveAxis,
      origin,
      decreasing,
      "θ",
      {
        radius: 2.5,
        fillColor: COLORS.red,
        strokeColor: COLORS.red,
      },
    );

    createText(board, 3.6, 0.45, "0°", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.1, 3.4, "0° < θ < 90°", {
      color: COLORS.green,
      fontSize: 16,
      cssStyle:
        "font-weight:700;background:white;padding:2px 5px;",
    });

    createText(board, -1.45, 5.5, "θ = 90°", {
      color: COLORS.orange,
      fontSize: 16,
      cssStyle:
        "font-weight:700;background:white;padding:2px 5px;",
    });

    createText(board, -5.6, 3.55, "90° < θ < 180°", {
      color: COLORS.red,
      fontSize: 16,
      cssStyle:
        "font-weight:700;background:white;padding:2px 5px;",
    });

    board.unsuspendUpdate();
  }

  function drawTangentRelation(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 8, 10, -2],
      interactive,
    );

    board.suspendUpdate();

    const triangle = createSlopeTriangle(
      board,
      6,
      4,
      "Δx",
      "Δy",
    );

    createLine(board, triangle.origin, triangle.end, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    const axisPoint = createHiddenPoint(board, 4, 0);

    createAngle(
      board,
      axisPoint,
      triangle.origin,
      triangle.end,
      "θ",
      {
        radius: 1.25,
      },
    );

    createText(board, 2.8, 6.7, "tan θ = Δy / Δx", {
      color: COLORS.purple,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 3.35, 5.75, "m = tan θ", {
      color: COLORS.dark,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawAngle45(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 7, 7, -2],
      interactive,
    );

    board.suspendUpdate();

    const triangle = createSlopeTriangle(
      board,
      3,
      3,
      "1",
      "1",
    );

    createLine(board, triangle.origin, triangle.end, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    const axisPoint = createHiddenPoint(board, 4, 0);

    createAngle(
      board,
      axisPoint,
      triangle.origin,
      triangle.end,
      "45°",
      {
        radius: 1.15,
      },
    );

    createText(board, 3.6, 4.4, "y = x", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.8, 5.65, "m = tan 45° = 1", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPositiveAngle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 8, 7, -2],
      interactive,
    );

    board.suspendUpdate();

    const triangle = createSlopeTriangle(
      board,
      2,
      4,
      "1",
      "2",
    );

    createLine(board, triangle.origin, triangle.end, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    const axisPoint = createHiddenPoint(board, 4, 0);

    createAngle(
      board,
      axisPoint,
      triangle.origin,
      triangle.end,
      "63.43°",
      {
        radius: 1.2,
      },
    );

    createText(board, 2.55, 5, "y = 2x", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.25, 6.5, "θ = tan⁻¹(2)", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawFractionComparison(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 7, 7, -3],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const halfPoint = createHiddenPoint(board, 4, 2);
    const onePoint = createHiddenPoint(board, 4, 4);
    const axisPoint = createHiddenPoint(board, 4, 0);

    createLine(board, origin, halfPoint, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, origin, onePoint, {
      strokeColor: COLORS.green,
      strokeWidth: 5,
    });

    createAngle(
      board,
      axisPoint,
      origin,
      halfPoint,
      "26.57°",
      {
        radius: 1.2,
        fillColor: COLORS.blue,
        strokeColor: COLORS.blue,
      },
    );

    createAngle(
      board,
      axisPoint,
      origin,
      onePoint,
      "45°",
      {
        radius: 2.1,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createText(board, 4.1, 2.25, "y = ½x", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 4.1, 4.25, "y = x", {
      color: COLORS.green,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -4.7, 6.1, "|m| mayor → mayor inclinación", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegativeAngle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const positiveAxis = createHiddenPoint(board, 5, 0);
    const negativeLinePoint = createHiddenPoint(board, -4, 4);
    const referencePoint = createHiddenPoint(board, 4, -4);

    createLine(board, origin, negativeLinePoint, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createSegment(board, origin, referencePoint, {
      strokeColor: COLORS.gray,
      strokeWidth: 2,
      dash: 2,
    });

    createAngle(
      board,
      positiveAxis,
      origin,
      negativeLinePoint,
      "135°",
      {
        radius: 2.2,
        fillColor: COLORS.red,
        strokeColor: COLORS.red,
      },
    );

    createAngle(
      board,
      referencePoint,
      origin,
      positiveAxis,
      "45°",
      {
        radius: 1.15,
        fillColor: COLORS.blue,
        strokeColor: COLORS.blue,
      },
    );

    createText(board, -5, 4.8, "y = −x", {
      color: COLORS.red,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -4.7, -5.8, "−45° + 180° = 135°", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawVerticalAngle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 8, 8, -2],
      interactive,
    );

    board.suspendUpdate();

    const intersection = createHiddenPoint(board, 3, 0);
    const positiveAxis = createHiddenPoint(board, 6, 0);
    const verticalPoint = createHiddenPoint(board, 3, 5);

    createLine(board, intersection, verticalPoint, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createSegment(board, intersection, positiveAxis, {
      strokeColor: COLORS.blue,
      strokeWidth: 4,
    });

    createAngle(
      board,
      positiveAxis,
      intersection,
      verticalPoint,
      "90°",
      {
        radius: 1.2,
        orthoType: "square",
      },
    );

    createText(board, 3.35, 5.6, "x = 3", {
      color: COLORS.red,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -0.8, 7, "θ = 90°", {
      color: COLORS.orange,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -0.8, 6.2, "m: indefinida", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawAngleComparison(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);

    const lines = [
      {
        point: [4, 2],
        color: COLORS.blue,
        label: "m = ½ · 26.57°",
        textPosition: [4.1, 2.2],
      },
      {
        point: [4, 4],
        color: COLORS.green,
        label: "m = 1 · 45°",
        textPosition: [3.9, 4.25],
      },
      {
        point: [2, 4],
        color: COLORS.orange,
        label: "m = 2 · 63.43°",
        textPosition: [1.65, 4.75],
      },
      {
        point: [-4, 4],
        color: COLORS.red,
        label: "m = −1 · 135°",
        textPosition: [-6.5, 4.4],
      },
      {
        point: [-2, 4],
        color: COLORS.purple,
        label: "m = −2 · 116.57°",
        textPosition: [-4.7, 5.7],
      },
    ];

    for (const item of lines) {
      const point = createHiddenPoint(
        board,
        item.point[0],
        item.point[1],
      );

      createLine(board, origin, point, {
        strokeColor: item.color,
        strokeWidth: 4,
      });

      createText(
        board,
        item.textPosition[0],
        item.textPosition[1],
        item.label,
        {
          color: item.color,
          fontSize: 15,
          cssStyle:
            "font-weight:700;background:white;padding:2px 5px;",
        },
      );
    }

    createText(board, -1.6, 6.5, "θ = 90°", {
      color: COLORS.gray,
      fontSize: 16,
      cssStyle:
        "font-weight:700;background:white;padding:2px 5px;",
    });

    createLine(board, [0, 0], [0, 4], {
      strokeColor: COLORS.gray,
      strokeWidth: 3,
      dash: 2,
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "angle-types":
        drawAngleTypes(boardId, interactive);
        break;

      case "tangent-relation":
        drawTangentRelation(boardId, interactive);
        break;

      case "angle-45":
        drawAngle45(boardId, interactive);
        break;

      case "angle-positive":
        drawPositiveAngle(boardId, interactive);
        break;

      case "fraction-comparison":
        drawFractionComparison(
          boardId,
          interactive,
        );
        break;

      case "negative-angle":
        drawNegativeAngle(boardId, interactive);
        break;

      case "vertical-angle":
        drawVerticalAngle(boardId, interactive);
        break;

      case "angle-comparison":
        drawAngleComparison(
          boardId,
          interactive,
        );
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-inclination-angle]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .inclination-angle {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .inclination-angle__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .inclination-angle__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .inclination-angle__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .inclination-angle__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .inclination-angle {
      margin-block: 1.25rem;
    }

    .inclination-angle__board {
      min-height: 390px;
    }
  }
</style>