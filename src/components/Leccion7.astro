---
export type LinesAngleGraphType =
  | "intersection-angles"
  | "inclination-difference"
  | "positive-slopes"
  | "parallel"
  | "perpendicular"
  | "four-points"
  | "supplementary-angles";

interface Props {
  type: LinesAngleGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId = `lines-angle-${type}-${crypto.randomUUID()}`;
---

<figure
  class="lines-angle-graph"
  data-lines-angle-graph
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="lines-angle-graph__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox lines-angle-graph__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Ángulo entre dos rectas"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "intersection-angles"
    | "inclination-difference"
    | "positive-slopes"
    | "parallel"
    | "perpendicular"
    | "four-points"
    | "supplementary-angles";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    cyan: "#0891b2",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
    label: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 1.2,
        name: label,
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.2,
        strokeColor: COLORS.orange,

        label: {
          fontSize: 17,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },

        ...options,
      },
    );
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.75,
        orthoType: "square",
        name: "90°",
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.18,
        strokeColor: COLORS.orange,

        label: {
          fontSize: 17,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },
      },
    );
  }

  function pointFromAngle(
    angleDegrees: number,
    radius = 5,
  ): [number, number] {
    const radians =
      (angleDegrees * Math.PI) / 180;

    return [
      radius * Math.cos(radians),
      radius * Math.sin(radians),
    ];
  }

  function drawIntersectionAngles(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);

    const line1Positive =
      createHiddenPoint(board, 5, 2.5);

    const line1Negative =
      createHiddenPoint(board, -5, -2.5);

    const line2Positive =
      createHiddenPoint(board, -2.5, 5);

    const line2Negative =
      createHiddenPoint(board, 2.5, -5);

    createLine(board, line1Negative, line1Positive, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, line2Negative, line2Positive, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createAngle(
      board,
      line1Positive,
      origin,
      line2Positive,
      "θ",
      {
        radius: 1.35,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createAngle(
      board,
      line2Positive,
      origin,
      line1Negative,
      "180° − θ",
      {
        radius: 2,
        fillColor: COLORS.orange,
        strokeColor: COLORS.orange,
      },
    );

    createAngle(
      board,
      line1Negative,
      origin,
      line2Negative,
      "θ",
      {
        radius: 1.35,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createAngle(
      board,
      line2Negative,
      origin,
      line1Positive,
      "180° − θ",
      {
        radius: 2,
        fillColor: COLORS.orange,
        strokeColor: COLORS.orange,
      },
    );

    createText(board, -3.4, 6.1, "Ángulos opuestos iguales", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawInclinationDifference(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -3],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const axis = createHiddenPoint(board, 5, 0);

    const point25 = pointFromAngle(25, 5);
    const point70 = pointFromAngle(70, 5);

    const line25 = createHiddenPoint(
      board,
      point25[0],
      point25[1],
    );

    const line70 = createHiddenPoint(
      board,
      point70[0],
      point70[1],
    );

    createLine(board, origin, line25, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, origin, line70, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createAngle(
      board,
      axis,
      origin,
      line25,
      "25°",
      {
        radius: 1,
        fillColor: COLORS.blue,
        strokeColor: COLORS.blue,
      },
    );

    createAngle(
      board,
      axis,
      origin,
      line70,
      "70°",
      {
        radius: 2,
        fillColor: COLORS.red,
        strokeColor: COLORS.red,
      },
    );

    createAngle(
      board,
      line25,
      origin,
      line70,
      "α = 45°",
      {
        radius: 2.8,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createText(board, -5.4, 6, "α = |70° − 25°|", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPositiveSlopes(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -3],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const halfSlope = createHiddenPoint(board, 4, 2);
    const doubleSlope = createHiddenPoint(board, 2, 4);

    createLine(board, origin, halfSlope, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, origin, doubleSlope, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createAngle(
      board,
      halfSlope,
      origin,
      doubleSlope,
      "36.87°",
      {
        radius: 2,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createText(board, 3.8, 2.4, "y = ½x", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 2.15, 4.4, "y = 2x", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -5.7, 6.1, "tan α = 3/4", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawParallel(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 9, 6, -9],
      interactive,
    );

    board.suspendUpdate();

    createLine(board, [0, 1], [1, 3], {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, [0, -4], [1, -2], {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createSegment(board, [-4, -7], [4, 9], {
      strokeColor: COLORS.gray,
      strokeWidth: 1.5,
      dash: 2,
    });

    createText(board, -3.8, 7.4, "y = 2x + 1", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 1, -2.3, "y = 2x − 4", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -5.1, -8, "m₁ = m₂ = 2", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 1, 7.7, "α = 0°", {
      color: COLORS.green,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawPerpendicular(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const firstLine = createHiddenPoint(board, 2, 4);
    const secondLine = createHiddenPoint(board, 4, -2);

    createLine(board, origin, firstLine, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, origin, secondLine, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createRightAngle(
      board,
      firstLine,
      origin,
      secondLine,
    );

    createText(board, 1.7, 4.8, "y = 2x", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, 3.2, -2.8, "y = −½x", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 6px;",
    });

    createText(board, -5.8, 6.1, "m₁m₂ = −1", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawFourPoints(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 7, 7, -4],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(1, 2)",
        x: 1,
        y: 2,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(5, 4)",
        x: 5,
        y: 4,
        color: COLORS.blue,
      },
      interactive,
    );

    const c = createPoint(
      board,
      {
        name: "C(-1, 4)",
        x: -1,
        y: 4,
        color: COLORS.red,
        labelOffset: [-78, 18],
      },
      interactive,
    );

    const d = createPoint(
      board,
      {
        name: "D(3, 0)",
        x: 3,
        y: 0,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    const line1 = createLine(board, a, b, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    const line2 = createLine(board, c, d, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    const intersection = board.create(
      "intersection",
      [line1, line2, 0],
      {
        name: "",
        visible: false,
        fixed: true,
      },
    );

    const line1Direction =
      createHiddenPoint(board, 5, 4);

    const line2Direction =
      createHiddenPoint(board, 3, 0);

    createAngle(
      board,
      line2Direction,
      intersection,
      line1Direction,
      "71.57°",
      {
        radius: 1.1,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createText(board, -4.4, 6.1, "m₁ = ½", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -4.4, 5.3, "m₂ = −1", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.5, 6, "tan α = 3", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawSupplementaryAngles(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);

    const line1Positive =
      createHiddenPoint(board, 5, 2);

    const line1Negative =
      createHiddenPoint(board, -5, -2);

    const line2Positive =
      createHiddenPoint(board, -3, 5);

    const line2Negative =
      createHiddenPoint(board, 3, -5);

    createLine(board, line1Negative, line1Positive, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, line2Negative, line2Positive, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createAngle(
      board,
      line1Positive,
      origin,
      line2Positive,
      "α",
      {
        radius: 1.2,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createAngle(
      board,
      line2Positive,
      origin,
      line1Negative,
      "180° − α",
      {
        radius: 2,
        fillColor: COLORS.orange,
        strokeColor: COLORS.orange,
      },
    );

    createAngle(
      board,
      line1Negative,
      origin,
      line2Negative,
      "α",
      {
        radius: 1.2,
        fillColor: COLORS.green,
        strokeColor: COLORS.green,
      },
    );

    createAngle(
      board,
      line2Negative,
      origin,
      line1Positive,
      "180° − α",
      {
        radius: 2,
        fillColor: COLORS.orange,
        strokeColor: COLORS.orange,
      },
    );

    createText(board, -4.7, 6.1, "α + (180° − α) = 180°", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "intersection-angles":
        drawIntersectionAngles(
          boardId,
          interactive,
        );
        break;

      case "inclination-difference":
        drawInclinationDifference(
          boardId,
          interactive,
        );
        break;

      case "positive-slopes":
        drawPositiveSlopes(boardId, interactive);
        break;

      case "parallel":
        drawParallel(boardId, interactive);
        break;

      case "perpendicular":
        drawPerpendicular(boardId, interactive);
        break;

      case "four-points":
        drawFourPoints(boardId, interactive);
        break;

      case "supplementary-angles":
        drawSupplementaryAngles(
          boardId,
          interactive,
        );
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-lines-angle-graph]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .lines-angle-graph {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .lines-angle-graph__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .lines-angle-graph__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .lines-angle-graph__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lines-angle-graph__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .lines-angle-graph {
      margin-block: 1.25rem;
    }

    .lines-angle-graph__board {
      min-height: 390px;
    }
  }
</style>