---
export type PerpendicularGraphType =
  | "cartesian-axes"
  | "inclination-relation"
  | "equation-example"
  | "construction-example"
  | "horizontal-vertical";

interface Props {
  type: PerpendicularGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId =
  `perpendicular-lines-${type}-${crypto.randomUUID()}`;
---

<figure
  class="perpendicular-lines"
  data-perpendicular-lines
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="perpendicular-lines__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox perpendicular-lines__board"
    style={`height:${height}px`}
    role="img"
    aria-label={
      description ??
      title ??
      "Gráfico de rectas perpendiculares"
    }
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";
 

  type GraphType =
    | "cartesian-axes"
    | "inclination-relation"
    | "equation-example"
    | "construction-example"
    | "horizontal-vertical";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis: true,
      grid: true,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,

      pan: {
        enabled: interactive,
      },

      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },

      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,

          label: {
            position: "rt",
            offset: [-14, 16],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },

        y: {
          name: "y",
          withLabel: true,

          label: {
            position: "rt",
            offset: [12, -12],
          },

          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createHiddenPoint(
    board: JXG.Board,
    x: number,
    y: number,
  ) {
    return board.create("point", [x, y], {
      name: "",
      visible: false,
      fixed: true,
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,

      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createLine(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("line", [first, second], {
      fixed: true,
      highlight: false,
      strokeWidth: 4,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createSegment(
    board: JXG.Board,
    first: unknown,
    second: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [first, second], {
      fixed: true,
      highlight: false,
      straightFirst: false,
      straightLast: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
    name: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 1.15,
        name,
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.18,
        strokeColor: COLORS.orange,

        label: {
          fontSize: 18,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },

        ...options,
      },
    );
  }

  function createRightAngle(
    board: JXG.Board,
    first: unknown,
    vertex: unknown,
    third: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create(
      "angle",
      [first, vertex, third],
      {
        radius: 0.65,
        orthoType: "square",
        name: "90°",
        withLabel: true,
        fixed: true,
        highlight: false,
        fillColor: COLORS.orange,
        fillOpacity: 0.2,
        strokeColor: COLORS.orange,

        label: {
          fontSize: 17,
          color: COLORS.orange,
          cssStyle: "font-weight:700;",
        },

        ...options,
      },
    );
  }

  function drawCartesianAxes(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const positiveX = createHiddenPoint(board, 4, 0);
    const positiveY = createHiddenPoint(board, 0, 4);

    createSegment(board, [-6, 0], [6, 0], {
      strokeColor: COLORS.blue,
      strokeWidth: 6,
      firstArrow: true,
      lastArrow: true,
    });

    createSegment(board, [0, -6], [0, 6], {
      strokeColor: COLORS.red,
      strokeWidth: 6,
      firstArrow: true,
      lastArrow: true,
    });

    createRightAngle(
      board,
      positiveX,
      origin,
      positiveY,
    );

    createText(board, 5.25, 0.55, "Eje X", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 0.35, 5.6, "Eje Y", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -5.4, 6.1, "X ⟂ Y", {
      color: COLORS.purple,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawInclinationRelation(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createHiddenPoint(board, 0, 0);
    const positiveAxis = createHiddenPoint(board, 5, 0);

    const firstDirection =
      createHiddenPoint(board, 4, 2);

    const secondDirection =
      createHiddenPoint(board, -2, 4);

    createLine(board, origin, firstDirection, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    createLine(board, origin, secondDirection, {
      strokeColor: COLORS.red,
      strokeWidth: 5,
    });

    createAngle(
      board,
      positiveAxis,
      origin,
      firstDirection,
      "θ",
      {
        radius: 1.15,
        fillColor: COLORS.blue,
        strokeColor: COLORS.blue,

        label: {
          fontSize: 18,
          color: COLORS.blue,
          cssStyle: "font-weight:700;",
        },
      },
    );

    createAngle(
      board,
      positiveAxis,
      origin,
      secondDirection,
      "θ + 90°",
      {
        radius: 2.5,
        fillColor: COLORS.red,
        strokeColor: COLORS.red,

        label: {
          fontSize: 18,
          color: COLORS.red,
          cssStyle: "font-weight:700;",
        },
      },
    );

    createRightAngle(
      board,
      firstDirection,
      origin,
      secondDirection,
      {
        radius: 0.75,
      },
    );

    createText(board, -5.5, 6.1, "m₂ = −1/m₁", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, -5.5, 5.2, "m₁m₂ = −1", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawEquationExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 10, 7, -8],
      interactive,
    );

    board.suspendUpdate();

    const line1 = createLine(
      board,
      [0, 1],
      [1, 3],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    const line2 = createLine(
      board,
      [0, 4],
      [2, 3],
      {
        strokeColor: COLORS.red,
        strokeWidth: 5,
      },
    );

    const intersection = board.create(
      "intersection",
      [line1, line2, 0],
      {
        name: "",
        visible: false,
        fixed: true,
      },
    );

    const firstDirection =
      createHiddenPoint(board, 3, 7);

    const secondDirection =
      createHiddenPoint(board, 5, 1.5);

    createRightAngle(
      board,
      firstDirection,
      intersection,
      secondDirection,
    );

    createText(board, -5.9, 8.7, "r₁: y = 2x + 1", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 1.4, 5.2, "r₂: y = −½x + 4", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -5.8, -6.8, "2(−½) = −1", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawConstructionExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-5, 11, 9, -5],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(2, 1)",
        x: 2,
        y: 1,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(6, 9)",
        x: 6,
        y: 9,
        color: COLORS.blue,
      },
      interactive,
    );

    const p = createPoint(
      board,
      {
        name: "P(4, 3)",
        x: 4,
        y: 3,
        color: COLORS.green,
        labelOffset: [10, -18],
      },
      interactive,
    );

    const originalLine = createLine(board, a, b, {
      strokeColor: COLORS.blue,
      strokeWidth: 5,
    });

    const perpendicularDirection =
      createHiddenPoint(board, 6, 2);

    const perpendicularLine = createLine(
      board,
      p,
      perpendicularDirection,
      {
        strokeColor: COLORS.red,
        strokeWidth: 5,
      },
    );

    const intersection = board.create(
      "intersection",
      [originalLine, perpendicularLine, 0],
      {
        name: "",
        visible: false,
        fixed: true,
      },
    );

    const originalDirection =
      createHiddenPoint(board, 6, 9);

    const perpendicularReference =
      createHiddenPoint(board, 7, 1.5);

    createRightAngle(
      board,
      originalDirection,
      intersection,
      perpendicularReference,
    );

    createText(board, -4.4, 10, "Recta original: m = 2", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(
      board,
      -4.4,
      9.1,
      "Perpendicular: m = −½",
      {
        color: COLORS.red,
        fontSize: 18,
        cssStyle:
          "font-weight:700;background:white;padding:3px 7px;",
      },
    );

    createText(
      board,
      -4.4,
      -3.9,
      "y = −½x + 5",
      {
        color: COLORS.purple,
        fontSize: 20,
        cssStyle:
          "font-weight:700;background:white;padding:4px 8px;",
      },
    );

    board.unsuspendUpdate();
  }

  function drawHorizontalVertical(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const horizontal = createLine(
      board,
      [0, 2],
      [1, 2],
      {
        strokeColor: COLORS.blue,
        strokeWidth: 5,
      },
    );

    const vertical = createLine(
      board,
      [-3, 0],
      [-3, 1],
      {
        strokeColor: COLORS.red,
        strokeWidth: 5,
      },
    );

    const intersection = board.create(
      "intersection",
      [horizontal, vertical, 0],
      {
        name: "",
        visible: false,
        fixed: true,
      },
    );

    const horizontalDirection =
      createHiddenPoint(board, 1, 2);

    const verticalDirection =
      createHiddenPoint(board, -3, 5);

    createRightAngle(
      board,
      horizontalDirection,
      intersection,
      verticalDirection,
    );

    createText(board, 3.3, 2.45, "y = 2", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -4.4, 5.5, "x = −3", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 1, 6.1, "Horizontal ⟂ Vertical", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    createText(board, 1, 5.2, "m = 0 e indefinida", {
      color: COLORS.dark,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(
    container: GraphContainer,
  ) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );

      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );

      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "cartesian-axes":
        drawCartesianAxes(boardId, interactive);
        break;

      case "inclination-relation":
        drawInclinationRelation(
          boardId,
          interactive,
        );
        break;

      case "equation-example":
        drawEquationExample(boardId, interactive);
        break;

      case "construction-example":
        drawConstructionExample(
          boardId,
          interactive,
        );
        break;

      case "horizontal-vertical":
        drawHorizontalVertical(
          boardId,
          interactive,
        );
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-perpendicular-lines]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .perpendicular-lines {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .perpendicular-lines__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .perpendicular-lines__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .perpendicular-lines__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .perpendicular-lines__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .perpendicular-lines {
      margin-block: 1.25rem;
    }

    .perpendicular-lines__board {
      min-height: 390px;
    }
  }
</style>