---
export type DistanceGraphType =
  | "number-line"
  | "general-triangle"
  | "positive-example"
  | "negative-example"
  | "horizontal-distance"
  | "origin-distance"
  | "circle-distance";

interface Props {
  type: DistanceGraphType;
  title?: string;
  description?: string;
  height?: number;
  interactive?: boolean;
}

const {
  type,
  title,
  description,
  height = 480,
  interactive = false,
} = Astro.props;

const boardId = `distance-${type}-${crypto.randomUUID()}`;
---

<figure
  class="distance-graph"
  data-distance-graph
  data-board-id={boardId}
  data-graph-type={type}
  data-interactive={String(interactive)}
>
  {
    title && (
      <figcaption class="distance-graph__caption">
        <strong>{title}</strong>
        {description && <span>{description}</span>}
      </figcaption>
    )
  }

  <div
    id={boardId}
    class="jxgbox distance-graph__board"
    style={`height:${height}px`}
    role="img"
    aria-label={description ?? title ?? "Distancia entre dos puntos"}
  >
  </div>
</figure>

<script>
  import JXG from "jsxgraph";

  type GraphType =
    | "number-line"
    | "general-triangle"
    | "positive-example"
    | "negative-example"
    | "horizontal-distance"
    | "origin-distance"
    | "circle-distance";

  interface GraphContainer extends HTMLElement {
    dataset: DOMStringMap & {
      boardId?: string;
      graphType?: GraphType;
      interactive?: string;
      initialized?: string;
    };
  }

  interface PointDefinition {
    name: string;
    x: number;
    y: number;
    color?: string;
    labelOffset?: [number, number];
  }

  const COLORS = {
    blue: "#2563eb",
    red: "#dc2626",
    green: "#16a34a",
    purple: "#7c3aed",
    orange: "#ea580c",
    gray: "#64748b",
    lightGray: "#cbd5e1",
    dark: "#172033",
  };

  function createBoard(
    boardId: string,
    boundingbox: [number, number, number, number],
    interactive: boolean,
    axis = true,
  ) {
    return JXG.JSXGraph.initBoard(boardId, {
      boundingbox,
      axis,
      grid: axis,
      keepAspectRatio: true,
      showCopyright: false,
      showNavigation: interactive,
      pan: {
        enabled: interactive,
      },
      zoom: {
        enabled: interactive,
        wheel: interactive,
        pinch: interactive,
      },
      defaultAxes: {
        x: {
          name: "x",
          withLabel: true,
          label: {
            position: "rt",
            offset: [-14, 16],
          },
          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
        y: {
          name: "y",
          withLabel: true,
          label: {
            position: "rt",
            offset: [12, -12],
          },
          ticks: {
            ticksDistance: 1,
            minorTicks: 0,
          },
        },
      },
    });
  }

  function createPoint(
    board: JXG.Board,
    point: PointDefinition,
    interactive: boolean,
  ) {
    return board.create("point", [point.x, point.y], {
      name: point.name,
      size: 4,
      fixed: !interactive,
      snapToGrid: interactive,
      snapSizeX: 1,
      snapSizeY: 1,
      strokeWidth: 2,
      strokeColor: point.color ?? COLORS.blue,
      fillColor: point.color ?? COLORS.blue,
      highlight: interactive,
      label: {
        offset: point.labelOffset ?? [8, 10],
        fontSize: 15,
        color: COLORS.dark,
        cssStyle: "font-weight:700;",
      },
    });
  }

  function createSegment(
    board: JXG.Board,
    start: unknown,
    end: unknown,
    options: Record<string, unknown> = {},
  ) {
    return board.create("segment", [start, end], {
      straightFirst: false,
      straightLast: false,
      fixed: true,
      highlight: false,
      strokeWidth: 3,
      strokeColor: COLORS.purple,
      ...options,
    });
  }

  function createText(
    board: JXG.Board,
    x: number,
    y: number,
    text: string,
    options: Record<string, unknown> = {},
  ) {
    return board.create("text", [x, y, text], {
      fixed: true,
      highlight: false,
      fontSize: 16,
      color: COLORS.dark,
      ...options,
    });
  }

  function createRightAngle(
    board: JXG.Board,
    firstPoint: unknown,
    vertex: unknown,
    thirdPoint: unknown,
  ) {
    return board.create(
      "angle",
      [firstPoint, vertex, thirdPoint],
      {
        radius: 0.45,
        orthoType: "square",
        withLabel: false,
        fixed: true,
        highlight: false,
        fillColor: "#ffffff",
        fillOpacity: 0.85,
        strokeColor: COLORS.gray,
      },
    );
  }

  function drawNumberLine(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [0, 3, 10, -3],
      interactive,
      false,
    );

    board.suspendUpdate();

    createSegment(board, [0.5, 0], [9.5, 0], {
      strokeColor: COLORS.dark,
      strokeWidth: 3,
      firstArrow: true,
      lastArrow: true,
    });

    for (let value = 1; value <= 9; value++) {
      createSegment(
        board,
        [value, -0.18],
        [value, 0.18],
        {
          strokeColor: COLORS.gray,
          strokeWidth: 2,
        },
      );

      createText(board, value - 0.12, -0.65, String(value), {
        fontSize: 14,
      });
    }

    board.create("point", [2, 0], {
      name: "A = 2",
      size: 5,
      fixed: true,
      strokeColor: COLORS.blue,
      fillColor: COLORS.blue,
      highlight: false,
      label: {
        offset: [-24, 22],
        fontSize: 17,
        color: COLORS.blue,
        cssStyle: "font-weight:700;",
      },
    });

    board.create("point", [8, 0], {
      name: "B = 8",
      size: 5,
      fixed: true,
      strokeColor: COLORS.red,
      fillColor: COLORS.red,
      highlight: false,
      label: {
        offset: [-24, 22],
        fontSize: 17,
        color: COLORS.red,
        cssStyle: "font-weight:700;",
      },
    });

    createSegment(board, [2, 1.15], [8, 1.15], {
      strokeColor: COLORS.purple,
      strokeWidth: 4,
      firstArrow: true,
      lastArrow: true,
    });

    for (let value = 2; value <= 8; value++) {
      createSegment(
        board,
        [value, 0.95],
        [value, 1.35],
        {
          strokeColor: COLORS.purple,
          strokeWidth: 2,
        },
      );
    }

    createText(board, 4.1, 1.75, "6 unidades", {
      color: COLORS.purple,
      fontSize: 18,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.15, -2, "d = |8 − 2| = 6", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawGeneralTriangle(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 8, 11, -2],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(x₁, y₁)",
        x: 2,
        y: 1,
        color: COLORS.blue,
        labelOffset: [-90, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(x₂, y₂)",
        x: 8,
        y: 6,
        color: COLORS.red,
      },
      interactive,
    );

    const auxiliary = board.create("point", [8, 1], {
      name: "",
      visible: false,
      fixed: true,
    });

    createSegment(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSegment(board, a, auxiliary, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, auxiliary, b, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createRightAngle(board, a, auxiliary, b);

    createText(board, 4, 0.55, "Δx = x₂ − x₁", {
      color: COLORS.blue,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:2px 6px;",
    });

    createText(board, 8.25, 3.2, "Δy = y₂ − y₁", {
      color: COLORS.red,
      fontSize: 17,
      cssStyle:
        "font-weight:700;background:white;padding:2px 6px;",
    });

    createText(board, 4.15, 4.25, "d", {
      color: COLORS.purple,
      fontSize: 22,
      cssStyle:
        "font-weight:700;background:white;padding:1px 7px;border-radius:999px;",
    });

    board.unsuspendUpdate();
  }

  function drawPositiveExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-1, 8, 11, -2],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(2, 1)",
        x: 2,
        y: 1,
        color: COLORS.blue,
        labelOffset: [-72, -18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(8, 5)",
        x: 8,
        y: 5,
        color: COLORS.red,
      },
      interactive,
    );

    const auxiliary = board.create("point", [8, 1], {
      name: "",
      visible: false,
      fixed: true,
    });

    createSegment(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSegment(board, a, auxiliary, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, auxiliary, b, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createRightAngle(board, a, auxiliary, b);

    createText(board, 4.8, 0.55, "6", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, 8.25, 2.8, "4", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.8, 3.5, "d = √52", {
      color: COLORS.purple,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, 2.8, 6.6, "d = 2√13 ≈ 7.21", {
      color: COLORS.dark,
      fontSize: 19,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawNegativeExample(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-6, 7, 8, -5],
      interactive,
    );

    board.suspendUpdate();

    const a = createPoint(
      board,
      {
        name: "A(-3, 4)",
        x: -3,
        y: 4,
        color: COLORS.blue,
        labelOffset: [-25, 18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(5, -2)",
        x: 5,
        y: -2,
        color: COLORS.red,
        labelOffset: [10, -18],
      },
      interactive,
    );

    const auxiliary = board.create("point", [5, 4], {
      name: "",
      visible: false,
      fixed: true,
    });

    createSegment(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSegment(board, a, auxiliary, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, auxiliary, b, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createRightAngle(board, a, auxiliary, b);

    createText(board, 0.8, 4.45, "Δx = 8", {
      color: COLORS.blue,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:2px 6px;",
    });

    createText(board, 5.25, 1.1, "|Δy| = 6", {
      color: COLORS.red,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:2px 6px;",
    });

    createText(board, -0.3, 0.3, "d = 10", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawHorizontalDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 10, -2],
      interactive,
    );

    board.suspendUpdate();

    board.create("line", [[0, 3], [1, 3]], {
      fixed: true,
      highlight: false,
      dash: 2,
      strokeColor: COLORS.lightGray,
      strokeWidth: 2,
    });

    const a = createPoint(
      board,
      {
        name: "A(-4, 3)",
        x: -4,
        y: 3,
        color: COLORS.blue,
        labelOffset: [-28, 18],
      },
      interactive,
    );

    const b = createPoint(
      board,
      {
        name: "B(7, 3)",
        x: 7,
        y: 3,
        color: COLORS.red,
      },
      interactive,
    );

    createSegment(board, a, b, {
      strokeColor: COLORS.purple,
      strokeWidth: 6,
    });

    for (let x = -4; x <= 7; x++) {
      createSegment(
        board,
        [x, 2.78],
        [x, 3.22],
        {
          strokeColor: COLORS.dark,
          strokeWidth: 1.5,
        },
      );
    }

    createText(board, 0.5, 4.2, "11 unidades", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 8px;",
    });

    createText(board, -0.5, 1.25, "d = |7 − (−4)| = 11", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    board.unsuspendUpdate();
  }

  function drawOriginDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-2, 7, 7, -2],
      interactive,
    );

    board.suspendUpdate();

    const origin = createPoint(
      board,
      {
        name: "O(0, 0)",
        x: 0,
        y: 0,
        color: COLORS.blue,
        labelOffset: [-65, -18],
      },
      interactive,
    );

    const p = createPoint(
      board,
      {
        name: "P(3, 4)",
        x: 3,
        y: 4,
        color: COLORS.red,
      },
      interactive,
    );

    const auxiliary = board.create("point", [3, 0], {
      name: "",
      visible: false,
      fixed: true,
    });

    createSegment(board, origin, p, {
      strokeColor: COLORS.purple,
      strokeWidth: 5,
    });

    createSegment(board, origin, auxiliary, {
      strokeColor: COLORS.blue,
      strokeWidth: 3,
      dash: 2,
    });

    createSegment(board, auxiliary, p, {
      strokeColor: COLORS.red,
      strokeWidth: 3,
      dash: 2,
    });

    createRightAngle(board, origin, auxiliary, p);

    createText(board, 1.35, -0.5, "3", {
      color: COLORS.blue,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, 3.25, 2, "4", {
      color: COLORS.red,
      fontSize: 19,
      cssStyle: "font-weight:700;",
    });

    createText(board, 1, 2.3, "5", {
      color: COLORS.purple,
      fontSize: 21,
      cssStyle:
        "font-weight:700;background:white;padding:2px 7px;border-radius:999px;",
    });

    createText(board, -0.4, 6, "d = √(3² + 4²) = 5", {
      color: COLORS.dark,
      fontSize: 18,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function drawCircleDistance(
    boardId: string,
    interactive: boolean,
  ) {
    const board = createBoard(
      boardId,
      [-7, 7, 7, -7],
      interactive,
    );

    board.suspendUpdate();

    const origin = createPoint(
      board,
      {
        name: "O(0, 0)",
        x: 0,
        y: 0,
        color: COLORS.blue,
        labelOffset: [-66, -18],
      },
      interactive,
    );

    const p = createPoint(
      board,
      {
        name: "P(3, 4)",
        x: 3,
        y: 4,
        color: COLORS.red,
      },
      interactive,
    );

    board.create("circle", [origin, 5], {
      fixed: true,
      highlight: false,
      strokeColor: COLORS.purple,
      strokeWidth: 4,
      fillColor: COLORS.purple,
      fillOpacity: 0.06,
    });

    createSegment(board, origin, p, {
      strokeColor: COLORS.orange,
      strokeWidth: 5,
    });

    createSegment(board, origin, [3, 0], {
      strokeColor: COLORS.blue,
      strokeWidth: 2,
      dash: 2,
    });

    createSegment(board, [3, 0], p, {
      strokeColor: COLORS.red,
      strokeWidth: 2,
      dash: 2,
    });

    createText(board, 1.25, 2.35, "r = 5", {
      color: COLORS.orange,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:3px 7px;",
    });

    createText(board, -2.25, 6.2, "x² + y² = 25", {
      color: COLORS.purple,
      fontSize: 20,
      cssStyle:
        "font-weight:700;background:white;padding:4px 8px;",
    });

    board.unsuspendUpdate();
  }

  function initializeGraph(container: GraphContainer) {
    if (container.dataset.initialized === "true") {
      return;
    }

    const boardId = container.dataset.boardId;
    const graphType = container.dataset.graphType;
    const interactive =
      container.dataset.interactive === "true";

    if (!boardId || !graphType) {
      console.error(
        "Faltan datos para inicializar el gráfico.",
      );
      return;
    }

    if (!document.getElementById(boardId)) {
      console.error(
        `No se encontró el contenedor ${boardId}.`,
      );
      return;
    }

    container.dataset.initialized = "true";

    switch (graphType) {
      case "number-line":
        drawNumberLine(boardId, interactive);
        break;

      case "general-triangle":
        drawGeneralTriangle(boardId, interactive);
        break;

      case "positive-example":
        drawPositiveExample(boardId, interactive);
        break;

      case "negative-example":
        drawNegativeExample(boardId, interactive);
        break;

      case "horizontal-distance":
        drawHorizontalDistance(boardId, interactive);
        break;

      case "origin-distance":
        drawOriginDistance(boardId, interactive);
        break;

      case "circle-distance":
        drawCircleDistance(boardId, interactive);
        break;

      default: {
        const exhaustiveCheck: never = graphType;

        console.error(
          `Tipo de gráfico no reconocido: ${exhaustiveCheck}`,
        );
      }
    }
  }

  function initializeAllGraphs() {
    const containers =
      document.querySelectorAll<GraphContainer>(
        "[data-distance-graph]",
      );

    containers.forEach(initializeGraph);
  }

  initializeAllGraphs();

  document.addEventListener(
    "astro:page-load",
    initializeAllGraphs,
  );
</script>

<style>
  .distance-graph {
    width: min(100%, 900px);
    margin: 2rem auto;
  }

  .distance-graph__caption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
    color: #172033;
  }

  .distance-graph__caption strong {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .distance-graph__caption span {
    color: #526078;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .distance-graph__board {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 8%),
      0 8px 24px rgb(15 23 42 / 8%);
  }

  :global(.JXGtext) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (max-width: 640px) {
    .distance-graph {
      margin-block: 1.25rem;
    }

    .distance-graph__board {
      min-height: 390px;
    }
  }
</style>