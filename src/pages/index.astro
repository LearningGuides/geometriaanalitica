---
import { getCollection } from "astro:content";

const lecciones = (await getCollection("lecciones")).sort(
  (a, b) => a.data.numero - b.data.numero
);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lecciones</title>
  </head>

  <body>
    <main>
      <h1>Lecciones</h1>
      <p>Selecciona una lección para comenzar.</p>

      <section class="grid">
        {
          lecciones.map((leccion) => (
            <a class="card" href={`geometriaanalitica/lecciones/${leccion.id}/`}>
				<p>Leccion {leccion.data.numero}</p>
              <h2>{leccion.data.titulo}</h2>

            </a>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    color: #1f2937;
    background: #f4f4f5;
  }

  main {
    width: min(100% - 2rem, 900px);
    margin: 0 auto;
    padding: 4rem 0;
  }

  h1 {
    margin-bottom: 0.5rem;
    font-size: 2.5rem;
  }

  main > p {
    margin-top: 0;
    margin-bottom: 2rem;
    color: #6b7280;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.5rem;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    color: inherit;
    background: white;
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgb(0 0 0 / 10%);
  }

  .card h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .card p {
    color: #6b7280;
    line-height: 1.5;
  }

  .card span {
    display: inline-block;
    margin-top: 1rem;
    color: #4f46e5;
    font-weight: 600;
  }
</style>